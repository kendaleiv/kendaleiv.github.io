---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  src: ImageMetadata;
  alt: string;
  width?: number;
};

const { src, alt, width = 700 } = Astro.props;
const fullImage = await getImage({ src, format: "webp" });
---

<a href={fullImage.src}>
  <Image src={src} alt={alt} width={Math.min(width, src.width)} format="webp" />
</a>

---
import { getRelativeLocaleUrl } from "astro:i18n";
import LinkButton from "@/components/LinkButton.astro";
import config from "@/config";

type Props = {
  headingTag?: "h1" | "h2";
  headingId?: string;
};

const { headingTag: Heading = "h2", headingId } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const avatarSize = Heading === "h1" ? 64 : 48;
---

<Heading
  id={headingId}
  class={Heading === "h1"
    ? "my-4 inline-flex items-center gap-3 align-middle text-4xl font-bold sm:my-8 sm:text-5xl"
    : "mb-4 inline-flex items-center gap-3 align-middle text-2xl font-semibold"}
>
  <img
    src={`https://www.gravatar.com/avatar/19c1d76389b58d1b972fc2be013bcc73.png?s=${avatarSize * 2}`}
    alt=""
    width={avatarSize}
    height={avatarSize}
    class="shrink-0 rounded-full"
    loading={Heading === "h1" ? "eager" : "lazy"}
    decoding="async"
  />
  Hi, I&apos;m Ken
</Heading>

<p>Jesus follower, husband, father, software engineer.</p>
<p class="mt-2">
  I share things I&apos;ve learned, problems I&apos;ve worked through, and notes
  worth keeping &mdash; mostly about software, sometimes about other things.
</p>
<p class="mt-2">
  Browse my{" "}
  <LinkButton
    class="hover:text-accent underline decoration-dashed underline-offset-4"
    href={getRelativeLocaleUrl(locale, "posts")}
  >
    {"posts"}
  </LinkButton>
  , explore my{" "}
  <LinkButton
    class="hover:text-accent underline decoration-dashed underline-offset-4"
    href={getRelativeLocaleUrl(locale, "speaking")}
  >
    {"speaking engagements"}
  </LinkButton>
  , or learn more{" "}
  <LinkButton
    class="hover:text-accent underline decoration-dashed underline-offset-4"
    href={getRelativeLocaleUrl(locale, "about")}
  >
    {"about me"}
  </LinkButton>.
</p>

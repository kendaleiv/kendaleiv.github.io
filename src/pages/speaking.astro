].sort(
  (a, b) =>
    Math.min(...b.deliveries.map(({ date }) => Date.parse(date))) -
    Math.min(...a.deliveries.map(({ date }) => Date.parse(date)))
);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
});

const formatDate = (date: string) =>
  dateFormatter.format(new Date(`${date}T00:00:00Z`));

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Speaking | ${config.site.title}`}
  description="Conference talks and presentations delivered by Ken Dale."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Speaking"
    pageDesc="Conference talks and presentations I've delivered."
  >
    <p class="mb-8">If you&apos;d like me to speak at an event, contact me!</p>

    <ol class="space-y-6">
      {
        talks.map(talk => (
          <li>
            <article class="border-border overflow-hidden rounded-lg border">
              <div class="flex flex-col gap-4 p-4 sm:flex-row sm:items-center">
                {talk.recording ? (
                  <a
                    class="bg-accent text-accent-foreground flex h-16 items-center justify-center rounded-md sm:w-20 sm:shrink-0"
                    href={talk.recording.url}
                    aria-label={`Watch the recording of ${talk.title}`}
                  >
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </a>
                ) : (
                  <div class="bg-muted text-muted-foreground flex h-16 items-center justify-center rounded-md text-xs font-semibold sm:w-20 sm:shrink-0">
                    No video
                  </div>
                )}

                <div class="min-w-0 flex-1">
                  <h2 class="text-lg font-semibold">{talk.title}</h2>
                  <p class="text-muted-foreground mt-1 text-sm">
                    {talk.deliveries.length}{" "}
                    {talk.deliveries.length === 1 ? "delivery" : "deliveries"}
                  </p>

                  {talk.summaryPath && (
                    <a
                      class="text-accent mt-2 inline-block text-sm decoration-dashed underline-offset-4 hover:underline"
                      href={getRelativeLocaleUrl(locale, talk.summaryPath)}
                      aria-label={`Read the summary of ${talk.title}`}
                    >
                      Read the talk summary
                    </a>
                  )}
                </div>

                {talk.recording && (
                  <a
                    class="text-accent shrink-0 text-sm font-medium decoration-dashed underline-offset-4 hover:underline"
                    href={talk.recording.url}
                    aria-label={`Watch the recording of ${talk.title}`}
                  >
                    Watch recording
                  </a>
                )}
              </div>

              <div class="border-border bg-muted/20 border-t p-4 sm:ps-28">
                <h3 class="mb-3 text-sm font-semibold">Delivered at</h3>
                <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
                  {[...talk.deliveries].reverse().map(delivery => (
                    <li class="border-accent border-s-2 ps-3">
                      <div class="text-sm font-medium">{delivery.venue}</div>
                      <div class="text-muted-foreground text-xs">
                        <time datetime={delivery.date}>
                          {formatDate(delivery.date)}
                        </time>
                        <span aria-hidden="true"> · </span>
                        {delivery.location}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </Main>

  <Footer />
</Layout>

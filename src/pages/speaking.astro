].sort(
  (a, b) =>
    Math.min(...b.deliveries.map(({ date }) => Date.parse(date))) -
    Math.min(...a.deliveries.map(({ date }) => Date.parse(date)))
);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
});

const formatDate = (date: string) =>
  dateFormatter.format(new Date(`${date}T00:00:00Z`));

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Speaking | ${config.site.title}`}
  description="Conference talks and presentations delivered by Ken Dale."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Speaking"
    pageDesc="Conference talks and presentations I've delivered."
  >
    <p class="mb-8">
      If you&apos;d like me to speak at an event, contact me! I&apos;m currently
      only interested in virtual events.
    </p>

    <ol class="space-y-8">
      {
        talks.map(talk => (
          <li>
            <article class="border-border overflow-hidden rounded-lg border">
              <div class="p-5 sm:p-6">
                <h2 class="text-xl font-semibold">{talk.title}</h2>

                {talk.summaryPath && (
                  <p class="mt-2">
                    <a
                      class="text-accent decoration-dashed underline-offset-4 hover:underline"
                      href={getRelativeLocaleUrl(locale, talk.summaryPath)}
                      aria-label={`Read the summary of ${talk.title}`}
                    >
                      Read the talk summary
                    </a>
                  </p>
                )}

                <h3 class="mt-5 font-semibold">Delivered at</h3>
                <ul class="mt-2 space-y-3">
                  {talk.deliveries.map(delivery => (
                    <li class="border-border border-s-2 ps-3">
                      <div class="font-medium">{delivery.venue}</div>
                      <div class="text-sm">
                        <time datetime={delivery.date}>
                          {formatDate(delivery.date)}
                        </time>
                        <span aria-hidden="true"> · </span>
                        {delivery.location}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>

              {talk.recording && (
                <div class="border-border border-t">
                  <div class="aspect-video">
                    <iframe
                      class="size-full"
                      src={talk.recording.embedUrl}
                      title={`${talk.recording.title} recording`}
                      loading="lazy"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    />
                  </div>
                  <p class="px-5 py-3 text-sm sm:px-6">
                    <a
                      class="text-accent decoration-dashed underline-offset-4 hover:underline"
                      href={talk.recording.url}
                      aria-label={`Watch the recording of ${talk.title}`}
                    >
                      Watch the recording
                    </a>
                  </p>
                </div>
              )}
            </article>
          </li>
        ))
      }
    </ol>
  </Main>

  <Footer />
</Layout>

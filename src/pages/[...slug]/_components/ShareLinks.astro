---
import LinkButton from "@/components/LinkButton.astro";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";
import ShareIcon from "@/assets/icons/socials/share.svg";

const { shareLinks } = config;
const t = useTranslations(Astro.currentLocale);

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const pageUrl = Astro.url;

const platformLabel = (name: string) =>
  name.charAt(0).toUpperCase() + name.slice(1);

const items = await Promise.all(
  shareLinks.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (name === "mail"
        ? t.post.sharePostViaEmail
        : tplStr(t.post.sharePostOn, { platform: platformLabel(name) }));
    return { url, title, Icon };
  })
);
---

{
  items.some(({ Icon }) => Icon) && (
    <div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start">
      <span class="italic">{t.post.sharePostIntro}</span>
      <div class="text-center">
        <button
          type="button"
          class="group inline-flex scale-90 items-center gap-1 p-2 hover:rotate-6 hover:text-accent sm:p-1"
          title={t.post.sharePostNative}
          data-share-button
          data-share-url={pageUrl.href}
          data-share-title={t.post.sharePostNative}
          data-copied-title={t.post.sharePostCopied}
        >
          <ShareIcon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
          <span class="sr-only" data-share-label>{t.post.sharePostNative}</span>
        </button>
        {items.map(({ url, title, Icon }) =>
          Icon ? (
            <LinkButton
              href={`${url}${encodeURIComponent(pageUrl.href)}`}
              class="scale-90 p-2 hover:rotate-6 sm:p-1"
              title={title}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
              <span class="sr-only">{title}</span>
            </LinkButton>
          ) : null
        )}
      </div>
    </div>
  )
}

<script>
  function attachShareButton() {
    const button = document.querySelector<HTMLButtonElement>(
      "[data-share-button]:not([data-share-ready])"
    );
    if (!button) return;

    button.dataset.shareReady = "true";
    button.addEventListener("click", async () => {
      const url = button.dataset.shareUrl ?? window.location.href;

      if (navigator.share) {
        try {
          await navigator.share({ url });
        } catch {
          // The user may have cancelled the share dialog.
        }
        return;
      }

      await navigator.clipboard.writeText(url);
      const copiedTitle = button.dataset.copiedTitle ?? "";
      const label = button.querySelector("[data-share-label]");
      button.title = copiedTitle;
      if (label) label.textContent = copiedTitle;

      setTimeout(() => {
        const shareTitle = button.dataset.shareTitle ?? "";
        button.title = shareTitle;
        if (label) label.textContent = shareTitle;
      }, 1500);
    });
  }

  attachShareButton();
  document.addEventListener("astro:page-load", attachShareButton);
</script>
